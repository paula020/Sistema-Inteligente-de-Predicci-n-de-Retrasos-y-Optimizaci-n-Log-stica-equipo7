# ============================================================================
# SmartDelay AI 360 - Plantilla de variables de entorno
# ============================================================================
# Copia este archivo como `.env` y completa los valores reales.
# El archivo `.env` NO debe subirse al repositorio.
# ============================================================================

# --- Entorno -------------------------------------------------------------------
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- API (FastAPI) -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=SmartDelay AI 360 API
API_VERSION=1.0.0

# --- Dashboard (Streamlit) -----------------------------------------------------
STREAMLIT_PORT=8501

# --- MLflow --------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=smartdelay-ai-360

# --- AWS / Bedrock -------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Modelo de Claude en Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.3

# --- Rutas de datos ------------------------------------------------------------
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
DATA_EXTERNAL_PATH=data/external
MODELS_PATH=models
REPORTS_PATH=reports
