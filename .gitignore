# ============================================================================
# SmartDelay AI 360 - Reglas de exclusión para Git
# ============================================================================

# --- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Entornos virtuales --------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Variables de entorno y secretos ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
aws-credentials*
secrets/

# --- Datos (no versionar datasets grandes ni sensibles) -----------------------
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
*.csv
*.parquet
*.feather
*.xlsx
*.xls
!data/README.md

# --- Modelos entrenados --------------------------------------------------------
models/*
!models/.gitkeep
*.pkl
*.joblib
*.bin
*.onnx
*.h5

# --- MLflow --------------------------------------------------------------------
mlruns/*
!mlruns/.gitkeep
mlartifacts/

# --- Reportes generados --------------------------------------------------------
reports/*
!reports/.gitkeep
*.html

# --- Jupyter -------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
.jupyter/

# --- Logs ----------------------------------------------------------------------
*.log
logs/

# --- IDE / Editor --------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Pruebas / Cobertura -------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Tipado / Linting ----------------------------------------------------------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Docker --------------------------------------------------------------------
.docker/
docker-compose.override.yml

# --- Sistema -------------------------------------------------------------------
*.tmp
*.bak
*.old
